<header class="site-header">
  <div class="container">
    <div class="top-header">
      <a href="/" class="logo-link">
        KIOSK
      </a>

      <div class="header-actions">
        <form action="/search" method="GET" class="search-form">
  <label for="site-search" class="sr-only">Search drinks</label>

  <div class="search-field">
    <i class="ph ph-magnifying-glass" aria-hidden="true"></i>

    <input
      type="search"
      id="site-search"
      name="q"
      class="form-input search-input"
      placeholder="Search drinks"
    >
  </div>
</form>

        <div class="header-icons">
          <a href="/favorites" class="icon-link" aria-label="Favorites">
  <% if (hasFavorites) { %>
    <i class="ph-fill ph-heart"></i>
  <% } else { %>
    <i class="ph ph-heart"></i>
  <% } %>
</a>

          <a href="/basket" class="header-basket" aria-label="Basket">
            <i class="ph ph-basket"></i>
            <span class="text-sm">(<%= basketCount %>)</span>
          </a>

          <% if (user) { %>
            <span class="account-link text-sm"><%= user.email %></span>

            <form action="/logout" method="POST" class="logout-form">
              <button type="submit" class="icon-link icon-button" aria-label="Log out">
                <i class="ph ph-sign-out"></i>
              </button>
            </form>
          <% } else { %>
            <a href="/login" class="icon-link" aria-label="Log in">
              <i class="ph ph-sign-in"></i>
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <nav class="site-nav" aria-label="Main navigation">
      <ul class="nav-list">
      
        <li>
          <a
            href="/news"
            class="<%= currentUrl.startsWith('/news') ? 'is-active' : '' %>"
          >
            New
          </a>
        </li>

        <li>
          <a
            href="/products"
            class="<%= currentUrl.startsWith('/products') ? 'is-active' : '' %>"
          >
            Drinks
          </a>
        </li>

        <% if (typeof categories !== "undefined" && categories.length) { %>
          <% categories.forEach(category => { %>
            <li>
              <a
                href="/categories/<%= category.slug %>"
                class="<%= currentUrl === '/categories/' + category.slug ? 'is-active' : '' %>"
              >
                <%= category.name %>
              </a>
            </li>
          <% }) %>
        <% } %>

      </ul>
    </nav>
  </div>
</header>