<header class="site-header">
  <div class="container">
    <div class="top-header">
      <a href="/" class="logo-link">KIOSK</a>

      <div class="header-actions">
        <form action="/search" method="GET" class="search-form">
          <label for="site-search" class="sr-only">Search drinks</label>
          <input
            type="search"
            id="site-search"
            name="q"
            class="form-input search-input"
            placeholder="Search drinks"
          >
        </form>

        <div class="header-icons">
          <a href="/favorites" class="icon-link" aria-label="Favorites">
            <i class="ph ph-heart"></i>
          </a>
          <a href="/basket" class="icon-link" aria-label="Basket">
            <i class="ph ph-basket"></i>
          </a>
          <a href="/login" class="icon-link" aria-label="Log in">
            <i class="ph ph-sign-in"></i>
          </a>
        </div>
      </div>
    </div>

    <nav class="site-nav" aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="/news">New</a></li>

        <% if (typeof categories !== "undefined" && categories.length) { %>
          <% categories.forEach(category => { %>
            <li>
              <a href="/categories/<%= category.slug %>"><%= category.name %></a>
            </li>
          <% }) %>
        <% } %>
      </ul>
    </nav>
  </div>
</header>