<!-- views/partials/product-card.ejs -->
<article class="card">
  <div class="card-image">
    <% if (product.is_new) { %>
      <span class="badge card-badge">New</span>
    <% } %>

    <% if (product.image_url) { %>
      <img src="<%= product.image_url %>" alt="<%= product.name %> can" />
    <% } %>

    <a href="#" class="card-favorite" aria-label="Favorite product">
      <i class="ph ph-heart"></i>
    </a>
  </div>

  <div class="card-body">
    <div class="card-meta">
      <h3 class="card-title">
        <a href="/products/<%= product.slug %>"><%= product.name %></a>
      </h3>
      <span class="card-price"><%= product.price %> SEK</span>
    </div>

    <p class="card-brand"><%= product.brand %></p>
  </div>
</article>
