<!-- views/partials/product-card.ejs -->
<article class="card">
  <a href="/products/<%= product.slug %>" class="card-link"></a>

  <div class="card-image">
    <% if (product.is_new) { %>
      <span class="badge card-badge">New</span>
    <% } %>

    <img src="<%= product.image_url %>" alt="<%= product.name %>" />

    <button class="card-favorite" aria-label="Add to favorites">
  <i class="ph ph-heart"></i>
</button>
  </div>

  <div class="card-body">
    <div class="card-meta">
      <h3 class="card-title"><%= product.name %></h3>
      <p class="card-price"><%= product.price %> kr</p>
    </div>
    <p class="card-brand"><%= product.brand %></p>
  </div>
</article>
