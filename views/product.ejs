      <section class="section product-layout">
        <div class="container">
          <div class="product-detail">
            <div class="product-media">
              <div class="product-image">
  <% if (product.image_url) { %>
    <img src="<%= product.image_url %>" alt="<%= product.name %> can" />
  <% } %>
</div>
            </div>

            <div class="product-info">
              <h1><%= product.name %></h1>

              <% if (product.description) { %>
                <p class="text-soft mt-md max-prose">
                  <%= product.description %>
                </p>
              <% } %>

              <p class="product-price mt-lg"><%= product.price %> SEK</p>

              <div class="mt-lg">
                <form action="/basket/add/<%= product.slug %>" method="POST" class="mt-lg">
  <button type="submit" class="btn btn-primary">Add to basket</button>
</form>
              </div>

              <p class="card-brand mt-md"><%= product.brand %></p>
            </div>
          </div>
        </div>
      </section>

      <section class="section product-related">
        <div class="container">
          <div class="section-header mb-lg">
            <h2>Related drinks</h2>
            <a href="/products" class="text-sm text-soft">View all &rarr;</a>
          </div>

          <div class="grid grid-products">
            <% relatedProducts.forEach(product => { %>
              <%- include('partials/product-card', { product: product, currentUrl: currentUrl }) %>
            <% }) %>
          </div>
        </div>
      </section>