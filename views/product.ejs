      <section class="section product-layout">
        <div class="container">
          <div class="product-detail">
            <div class="product-media">
              <div class="product-image">
  <% if (product.image_url) { %>
    <img src="<%= product.image_url %>" alt="<%= product.name %> can" />
  <% } %>

  <form
    action="/favorites/toggle/<%= product.slug %>"
    method="POST"
    class="card-favorite-form"
  >
    <input type="hidden" name="redirectTo" value="<%= currentUrl %>" />

    <button class="card-favorite" type="submit" aria-label="Toggle favorite">
      <% if (product.is_favorite) { %>
        <i class="ph-fill ph-heart"></i>
      <% } else { %>
        <i class="ph ph-heart"></i>
      <% } %>
    </button>
  </form>
</div>
            </div>

            <div class="product-info">
              <h1><%= product.name %></h1>

              <p class="card-brand"><%= product.brand %></p>

              <% if (product.description) { %>
                <p class="text-soft mt-md max-prose">
                  <%= product.description %>
                </p>
              <% } %>

              <p class="product-price mt-lg"><%= product.price %> SEK</p>

              <div class="mt-lg">
                <form action="/basket/add/<%= product.slug %>" method="POST" class="mt-lg">
  <button type="submit" class="btn btn-primary">Add to basket</button>
</form>
              </div>

            </div>
          </div>
        </div>
      </section>

      <section class="section product-related">
        <div class="container">
          <div class="section-header section-header-centered mb-lg">
  <h2>Related drinks</h2>
</div>

          <div class="related-slider">
  <button class="related-slider-button related-slider-prev" type="button" aria-label="Previous related products">
    <i class="ph ph-caret-left"></i>
  </button>

  <div class="related-slider-track">
    <% relatedProducts.forEach(product => { %>
      <div class="related-slider-item">
        <%- include('partials/product-card', { product: product, currentUrl: currentUrl }) %>
      </div>
    <% }) %>
  </div>

  <button class="related-slider-button related-slider-next" type="button" aria-label="Next related products">
    <i class="ph ph-caret-right"></i>
  </button>
</div>
        </div>
      </section>

<script src="/javascripts/related-slider.js"></script>