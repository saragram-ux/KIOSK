<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { categories: categories, user: locals.user }) %>

    <main class="site-main">
      <%- include('partials/hero', { hero: hero }) %>

      <section class="section home-products">
        <div class="container">
          <div class="section-header mb-lg">
            <h2>New this week</h2>
            <a href="/products" class="text-sm text-soft">View all &rarr;</a>
          </div>

          <div class="grid grid-products">
  <% products.forEach(product => { %>
    <%- include('partials/product-card', { product: product }) %>
  <% }) %>
</div>
        </div>
      </section>

      <section class="section home-categories">
  <div class="container">
    <p class="label mb-md">Browse by mood</p>
    <h2 class="mb-lg">Categories</h2>

    <div class="grid grid-2">
      <% categories.forEach(category => { %>
        <%- include('partials/category-card', { category: category }) %>
      <% }) %>
    </div>
  </div>
</section>

      <section class="section section-alt home-signup">
        <div class="container-narrow">
          <h2>Stay in the loop</h2>
          <p class="text-soft mt-sm mb-lg">
            Seasonal drops, new menu items, and zero spam. Takes ten seconds.
          </p>

          <form action="/newsletter" method="POST" class="form-inline">
            <label for="email" class="sr-only">Email address</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input"
              placeholder="your@email.com"
              required
            />
            <button type="submit" class="btn btn-accent">Sign up</button>
          </form>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
