<div class="admin-main-header">
  <div>
    <h1>Products</h1>
  </div>

  <a href="/admin/products/new" class="btn btn-primary">
    New product
  </a>
</div>

<% if (products.length > 0) { %>
  <div class="admin-table-wrap mt-lg">
    <table class="admin-data-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">SKU</th>
          <th scope="col">Brand</th>
          <th scope="col">Price</th>
          <th scope="col">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>

      <tbody>
        <% products.forEach(product => { %>
          <tr>
            <td data-label="Name">
              <strong><%= product.name %></strong>
            </td>

            <td data-label="SKU" class="text-soft">
              <%= product.sku %>
            </td>

            <td data-label="Brand">
              <%= product.brand %>
            </td>

            <td data-label="Price">
              <%= product.price %> SEK
            </td>

            <td data-label="Actions">
              <div class="admin-actions admin-icon-actions">
  <a
    href="/admin/products/<%= product.id %>/edit"
    class="admin-icon-button"
    aria-label="Edit <%= product.name %>"
  >
    <i class="ph ph-pencil-simple" aria-hidden="true"></i>
  </a>

  <form
    action="/admin/products/<%= product.id %>/delete"
    method="POST"
  >
    <button
      type="submit"
      class="admin-icon-button"
      aria-label="Delete <%= product.name %>"
    >
      <i class="ph ph-trash" aria-hidden="true"></i>
    </button>
  </form>
</div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <p class="text-soft mt-md">No products yet.</p>
<% } %>