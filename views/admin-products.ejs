<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <main class="site-main">
      <section class="section admin-layout">
        <div class="container">
          <p class="label mb-md">Administration</p>
          <h1>Products</h1>

          <div class="mt-lg">
            <a href="/admin/products/new" class="btn btn-primary">New product</a>
          </div>

          <div class="mt-lg">
            <% if (products.length > 0) { %>
              <div class="admin-table">
                <% products.forEach(product => { %>
                 <div class="admin-row">
  <span><strong><%= product.name %></strong></span>
  <span><%= product.brand %></span>
  <span><%= product.price %> SEK</span>

  <div class="admin-actions">
    <a href="/admin/products/<%= product.id %>/edit" class="btn btn-secondary btn-sm">
      Edit
    </a>

    <form action="/admin/products/<%= product.id %>/delete" method="POST" style="display:inline;">
      <button type="submit" class="btn btn-secondary btn-sm">
        Delete
      </button>
    </form>
  </div>
</div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-soft mt-md">No products yet.</p>
            <% } %>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>