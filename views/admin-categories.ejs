<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <main class="site-main">
      <section class="section admin-layout">
        <div class="container">
          <p class="label mb-md">Administration</p>
          <h1>Categories</h1>

          <div class="mt-lg">
            <a href="/admin/categories/new" class="btn btn-primary">New category</a>
          </div>

          <div class="mt-lg">
            <% if (categories.length > 0) { %>
              <div class="admin-table">
                <% categories.forEach(category => { %>
                  <div class="admin-row admin-row-categories">
                    <span><strong><%= category.name %></strong></span>
                    <span><%= category.slug %></span>

                    <div class="admin-actions">
                      <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-secondary btn-sm">
                        Edit
                      </a>

                      <form action="/admin/categories/<%= category.id %>/delete" method="POST" style="display:inline;">
                        <button type="submit" class="btn btn-secondary btn-sm">
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-soft mt-md">No categories yet.</p>
            <% } %>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>