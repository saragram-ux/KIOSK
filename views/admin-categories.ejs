<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>

  <body>
    <main class="site-main admin-site-main">
      <section class="admin-page">
        <div class="admin-header">
          <div class="container">
            <p class="admin-label">Administration</p>
          </div>
        </div>

        <div class="container">
          <div class="admin-shell">
            <%- include('partials/admin-sidebar') %>

            <div class="admin-main">
              <div class="admin-main-header">
                <div>
                  <p class="label mb-md">Categories</p>
                  <h1>Categories</h1>
                </div>

                <a href="/admin/categories/new" class="btn btn-primary">
                  New category
                </a>
              </div>

              <% if (categories.length > 0) { %>
                <div class="admin-table-wrap mt-lg">
                  <table class="admin-data-table">
                    <thead>
                      <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Slug</th>
                        <th scope="col">
                          <span class="sr-only">Actions</span>
                        </th>
                      </tr>
                    </thead>

                    <tbody>
                      <% categories.forEach(category => { %>
                        <tr>
                          <td data-label="Name">
                            <strong><%= category.name %></strong>
                          </td>

                          <td data-label="Slug">
                            <%= category.slug %>
                          </td>

                          <td data-label="Actions">
                            <div class="admin-actions">
                              <a
                                href="/admin/categories/<%= category.id %>/edit"
                                class="btn btn-secondary btn-sm"
                              >
                                Edit
                              </a>

                              <form
                                action="/admin/categories/<%= category.id %>/delete"
                                method="POST"
                              >
                                <button type="submit" class="btn btn-secondary btn-sm">
                                  Delete
                                </button>
                              </form>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-soft mt-md">No categories yet.</p>
              <% } %>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>