<div class="admin-main-header">
  <div>
    <h1>Categories</h1>
  </div>

  <a href="/admin/categories/new" class="btn btn-primary">
    New category
  </a>
</div>

<% if (categories.length > 0) { %>
  <div class="admin-table-wrap mt-lg">
    <table class="admin-data-table">
      <thead>
        <tr>
          <th scope="col">Name</th>
          <th scope="col">Slug</th>
          <th scope="col">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>

      <tbody>
        <% categories.forEach(category => { %>
          <tr>
            <td data-label="Name">
              <strong><%= category.name %></strong>
            </td>

            <td data-label="Slug">
              <%= category.slug %>
            </td>

            <td data-label="Actions">
             <div class="admin-actions admin-icon-actions">
  <a
    href="/admin/categories/<%= category.id %>/edit"
    class="admin-icon-button"
    aria-label="Edit <%= category.name %>"
  >
    <i class="ph ph-pencil-simple" aria-hidden="true"></i>
  </a>

  <form
    action="/admin/categories/<%= category.id %>/delete"
    method="POST"
  >
    <button
      type="submit"
      class="admin-icon-button"
      aria-label="Delete <%= category.name %>"
    >
      <i class="ph ph-trash" aria-hidden="true"></i>
    </button>
  </form>
</div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <p class="text-soft mt-md">No categories yet.</p>
<% } %>