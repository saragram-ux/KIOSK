      <section class="section basket-page">
        <div class="container">
          <p class="label mb-md">Basket</p>
          <h1>Your basket</h1>

        <% if (basket.length > 0) { %>
  <% let total = 0; %>

  <div class="basket-table-wrap mt-lg">
    <table class="basket-table">
      <thead>
        <tr>
          <th scope="col">Product</th>
          <th scope="col">Price</th>
          <th scope="col">Total</th>
          <th scope="col">Quantity</th>
        </tr>
      </thead>

      <tbody>
        <% basket.forEach(item => { %>
          <% const itemTotal = item.price * item.quantity; %>
          <% total += itemTotal; %>

          <tr>
            <td class="basket-product-cell">
              <strong><%= item.name %></strong>
            </td>

            <td class="basket-price text-mono">
              <%= item.price %> SEK
            </td>

            <td class="basket-total text-mono">
              <%= itemTotal %> SEK
            </td>

            <td class="basket-actions-cell">
              <div class="basket-actions">
                <form action="/basket/update/<%= item.slug %>" method="POST">
                  <label class="sr-only" for="quantity-<%= item.slug %>">
                    Quantity for <%= item.name %>
                  </label>

                  <select
                    id="quantity-<%= item.slug %>"
                    name="quantity"
                    class="basket-quantity-select"
                    onchange="this.form.submit()"
                  >
                    <% for (let i = 1; i <= 10; i++) { %>
                      <option value="<%= i %>" <%= item.quantity === i ? "selected" : "" %>>
                        <%= i %>
                      </option>
                    <% } %>
                  </select>
                </form>

                <form action="/basket/remove/<%= item.slug %>" method="POST">
                  <button
                    type="submit"
                    class="basket-remove-button"
                    aria-label="Remove <%= item.name %>"
                  >
                    <i class="ph ph-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="basket-summary mt-lg">
    <h2>Total</h2>
    <p class="product-price mt-sm"><%= total %> SEK</p>

    <div class="mt-lg">
      <button type="button" class="btn btn-accent">Checkout</button>
    </div>
  </div>
<% } else { %>
            <div class="card-text mt-lg">
              <div class="card-body">
                <h3>Your basket is empty</h3>
                <p class="text-soft mt-sm">
                  Add something from the menu to get started.
                </p>
                <span class="card-count">
                  <a href="/products">Browse drinks &rarr;</a>
                </span>
              </div>
            </div>
          <% } %>
        </div>
      </section>