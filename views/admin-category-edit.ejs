<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
  <main class="site-main admin-site-main">
    <section class="admin-page">
      <div class="admin-header">
        <div class="container">
          <p class="admin-label">Administration</p>
        </div>
      </div>

      <div class="container">
        <div class="admin-shell">
          <%- include('partials/admin-sidebar') %>

          <div class="admin-main admin-form-main">
            <p class="label mb-md">Administration</p>
          <h1>Edit category</h1>

          <form action="/admin/categories/<%= category.id %>/edit" method="POST" enctype="multipart/form-data" class="auth-form mt-lg">
            <div class="form-group">
              <label for="name" class="form-label">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                value="<%= formData.name %>"
                required
              />
              <% if (errors.name) { %>
                <p class="form-error"><%= errors.name %></p>
              <% } %>
            </div>

            <div class="form-group mt-md">
              <label for="slug" class="form-label">Slug</label>
              <input
                type="text"
                id="slug"
                name="slug"
                class="form-input"
                value="<%= formData.slug %>"
                required
              />
              <% if (errors.slug) { %>
                <p class="form-error"><%= errors.slug %></p>
              <% } %>
            </div>

            <div class="form-group mt-md">
              <label for="description" class="form-label">Description</label>
              <textarea
                id="description"
                name="description"
                class="form-input"
                rows="4"
              ><%= formData.description %></textarea>
            </div>

            <div class="form-group mt-md">
  <label for="image" class="form-label">Replace image</label>

  <% if (formData.image_url) { %>
    <p class="text-soft text-sm mb-md">
      Current image: <%= formData.image_url %>
    </p>
  <% } %>

  <input
    type="file"
    id="image"
    name="image"
    class="form-input"
    accept="image/*"
  />
</div>

            <div class="mt-lg">
              <button type="submit" class="btn btn-primary">Update category</button>
            </div>
          </form>
                 </div>
        </div>
      </div>
    </section>
  </main>
</body>
</html>